{
  "name": "ashen-pixel",
  "version": "1.0.0",
  "private": true,
  "description": "Пепельный Пиксель — школа вёрстки в духе Souls: сервер на Node.js и SQLite",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "reset-db": "node --disable-warning=ExperimentalWarning server/index.js --reset",
    "set-password": "node --disable-warning=ExperimentalWarning server/set-password.js",
    "test:e2e": "node tools/e2e.mjs",
    "test:tasks": "node tools/check-tasks.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
